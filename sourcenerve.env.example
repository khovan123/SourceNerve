# Copy this file to ./sourcenerve.env on the VPS and replace placeholders.
# The real ./sourcenerve.env is ignored by Git and loaded automatically by SourceNerve.
# Existing PM2/system environment variables take precedence over values in this file.

SOURCENERVE_CONFIG=sourcenerve.toml
RUST_LOG=sourcenerve=info

# Control-plane OAuth. These authenticate Desktop enrollment requests.
SOURCENERVE_OAUTH_ISSUER=https://YOUR_AUTH0_TENANT.auth0.com/
SOURCENERVE_OAUTH_RESOURCE=https://YOUR_PUBLIC_DOMAIN/mcp
SOURCENERVE_OAUTH_ALLOW_OPERATOR_BEARER=false

# Desktop Bootstrap Broker. These credentials exist only on the central VPS.
SOURCENERVE_DESKTOP_BROKER_ENABLED=true
SOURCENERVE_CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
SOURCENERVE_CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id
SOURCENERVE_CLOUDFLARE_API_TOKEN=replace-with-scoped-cloudflare-api-token
SOURCENERVE_DESKTOP_HOSTNAME_SUFFIX=mcp.sourcenerve.fogewise.io.vn

# Optional production metrics. Keep public metrics false unless protected by network policy.
# SOURCENERVE_METRICS_ENABLED=true
# SOURCENERVE_METRICS_PUBLIC=false

# Optional OpenTelemetry export.
# SOURCENERVE_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-me

# Deliberately absent from the VPS control plane:
# - SOURCENERVE_BEARER_TOKEN
# - SOURCENERVE_GITHUB_TOKEN / SOURCENERVE_GITLAB_TOKEN
# - SOURCENERVE_OPENAI_API_KEY
# - repository/workspace configuration
# Those belong to each Desktop-managed local data-plane daemon.
