# Copy this file to ./sourcenerve.env on the VPS and replace placeholders.
# The real ./sourcenerve.env is ignored by Git and loaded automatically by SourceNerve.
# Existing PM2/system environment variables take precedence over values in this file.

# Optional explicit config path. The default is already ./sourcenerve.toml.
SOURCENERVE_CONFIG=sourcenerve.toml

# Required for normal authenticated API/private MCP operation.
# Generate for example with: openssl rand -hex 32
SOURCENERVE_BEARER_TOKEN=replace-with-a-long-random-secret-at-least-24-chars

# Optional logging level. Because the env file loads before tracing starts,
# RUST_LOG can be controlled here.
RUST_LOG=sourcenerve=info

# Optional GitHub lifecycle access.
# SOURCENERVE_GITHUB_TOKEN=github_pat_xxx

# Optional GitLab lifecycle access.
# SOURCENERVE_GITLAB_TOKEN=glpat-xxx

# Optional managed OpenAI embeddings.
# SOURCENERVE_OPENAI_API_KEY=sk-xxx
# SOURCENERVE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional job/GitHub webhook verification secrets.
# SOURCENERVE_WEBHOOK_SECRET=replace-with-a-long-random-secret
# SOURCENERVE_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional outbound callback configuration. Configure both together.
# SOURCENERVE_CALLBACK_URL=https://example.com/source-nerve-callback
# SOURCENERVE_CALLBACK_SECRET=replace-with-a-long-random-secret

# Optional production metrics. Keep SOURCENERVE_METRICS_PUBLIC unset/false unless
# the endpoint is protected by network policy.
# SOURCENERVE_METRICS_ENABLED=true
# SOURCENERVE_METRICS_PUBLIC=false

# Optional OpenTelemetry export.
# SOURCENERVE_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-me

# Only set during OpenAI Apps ownership verification when requested.
# SOURCENERVE_OPENAI_APPS_CHALLENGE=replace-me
