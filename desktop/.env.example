# Copy to desktop/.env before local development/package materialization.
# Do not use shell `export` commands.
# Auth0 issuer, audience/resource, and Native Application client ID are fetched
# from the backend at runtime and therefore do not belong in this file.

SOURCENERVE_BOOTSTRAP_BROKER_URL=https://sourcenerve.fogewise.io.vn

# Optional: override the public Plugin Registry endpoint for development/testing.
# Production defaults to the SourceNerve public registry on the main branch.
# SOURCENERVE_PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/khovan123/SourceNerve/main/.agents/plugins/public-registry.json
