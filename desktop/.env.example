# Copy to desktop/.env before local development/package materialization.
# Do not use shell `export` commands.
# SourceNerve account/OAuth configuration is not required by Desktop.

SOURCENERVE_BOOTSTRAP_BROKER_URL=https://sourcenerve.fogewise.io.vn

# Optional: override the public Plugin Marketplace endpoint for development/testing.
# Production defaults to OpenAI's public Codex plugin marketplace. SourceNerve also
# appends its own first-party plugin entry to that remote catalog.
# SOURCENERVE_PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/openai/plugins/main/.agents/plugins/marketplace.json
