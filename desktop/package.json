{
  "name": "sourcenerve-desktop",
  "productName": "SourceNerve",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform SourceNerve desktop application",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "daemon:build": "cargo build --release --manifest-path ../Cargo.toml",
    "daemon:stage": "node scripts/stage-daemon.mjs",
    "predev": "npm run daemon:build && npm run daemon:stage",
    "dev": "electron-forge start",
    "prepackage": "npm run daemon:build && npm run daemon:stage",
    "package": "electron-forge package",
    "postpackage": "node scripts/verify-packaged-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vite.renderer.config.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "@electron-forge/shared-types": "^7.8.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^33.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
