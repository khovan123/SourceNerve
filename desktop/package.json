{
  "name": "sourcenerve-desktop",
  "productName": "SourceNerve",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform SourceNerve desktop application",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "icons:generate": "node scripts/generate-platform-icons.mjs",
    "daemon:version-check": "node scripts/verify-daemon-version.mjs",
    "daemon:build": "cargo build --release --manifest-path ../Cargo.toml",
    "daemon:stage": "node scripts/stage-daemon.mjs",
    "cloudflared:stage": "node scripts/stage-cloudflared.mjs",
    "security:check": "node scripts/verify-security-baseline.mjs",
    "prepare:artifacts": "npm run icons:generate && npm run security:check && npm run daemon:version-check && npm run daemon:build && npm run daemon:stage && npm run cloudflared:stage",
    "predev": "npm run prepare:artifacts",
    "dev": "electron-forge start",
    "prepackage": "npm run prepare:artifacts",
    "package": "electron-forge package",
    "postpackage": "node scripts/verify-packaged-daemon.mjs && node scripts/verify-packaged-cloudflared.mjs",
    "premake": "npm run prepare:artifacts",
    "make": "electron-forge make",
    "make:dmg": "node scripts/make-dmg.mjs",
    "make:nsis": "node scripts/make-nsis.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-electron-runtime.mjs",
    "test": "vitest run --config vite.renderer.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test:packaged": "node scripts/verify-packaged-quality.mjs",
    "test:distribution": "node scripts/verify-distribution-artifacts.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@reforged/maker-appimage": "5.2.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "43.3.0",
    "sharp": "0.35.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fdir": {
      "picomatch": "^4.0.5"
    }
  }
}
