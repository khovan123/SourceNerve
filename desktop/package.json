{
  "name": "sourcenerve-desktop",
  "productName": "SourceNerve",
  "desktopName": "sourcenerve.desktop",
  "version": "0.1.16",
  "private": true,
  "description": "Cross-platform SourceNerve desktop application",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "icons:generate": "node scripts/generate-platform-icons.mjs",
    "daemon:version-check": "node scripts/verify-daemon-version.mjs",
    "daemon:build": "cargo build --release --manifest-path ../Cargo.toml",
    "daemon:stage": "node scripts/stage-daemon.mjs",
    "cloudflared:stage": "node scripts/stage-cloudflared.mjs",
    "plugin-catalog:stage": "node scripts/stage-plugin-catalog.mjs",
    "plugin-catalog:verify-packaged": "node scripts/verify-packaged-plugin-catalog.mjs",
    "rpm:compat": "node scripts/patch-rpm-installer-compat.mjs",
    "security:check": "node scripts/verify-security-baseline.mjs",
    "release:contract": "node scripts/verify-release-contract.mjs",
    "release:secret-scan": "node scripts/verify-release-secret-scan.mjs",
    "release:workflow-check": "node scripts/verify-release-workflow.mjs",
    "test:release-bundle": "node scripts/verify-release-bundle.mjs",
    "prepare:artifacts": "npm run icons:generate && npm run security:check && npm run daemon:version-check && npm run daemon:build && npm run daemon:stage && npm run cloudflared:stage && npm run plugin-catalog:stage",
    "predev": "npm run prepare:artifacts",
    "dev": "electron-forge start",
    "prepackage": "npm run prepare:artifacts",
    "package": "electron-forge package",
    "postpackage": "node scripts/verify-packaged-daemon.mjs && node scripts/verify-packaged-cloudflared.mjs && npm run plugin-catalog:verify-packaged",
    "premake": "npm run prepare:artifacts && npm run rpm:compat",
    "make": "electron-forge make",
    "make:dmg": "node scripts/make-dmg.mjs",
    "make:nsis": "node scripts/make-nsis.mjs",
    "update:manifest": "node scripts/generate-update-manifest.mjs",
    "test:update-manifest": "node scripts/verify-update-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-electron-runtime.mjs",
    "test": "vitest run --config vite.renderer.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:codex:e2e": "node scripts/run-codex-e2e.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test:packaged": "node scripts/verify-packaged-quality.mjs",
    "test:distribution": "node scripts/verify-distribution-artifacts.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@playwright/test": "1.62.0",
    "@reforged/maker-appimage": "5.2.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "43.3.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fdir": {
      "picomatch": "^4.0.5"
    },
    "fast-uri": "3.1.6"
  }
}
