{
  "name": "sourcenerve-desktop",
  "productName": "SourceNerve",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform SourceNerve desktop application",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "daemon:version-check": "node scripts/verify-daemon-version.mjs",
    "daemon:build": "cargo build --release --manifest-path ../Cargo.toml",
    "daemon:stage": "node scripts/stage-daemon.mjs",
    "security:check": "node scripts/verify-security-baseline.mjs",
    "predev": "npm run security:check && npm run daemon:version-check && npm run daemon:build && npm run daemon:stage",
    "dev": "electron-forge start",
    "prepackage": "npm run security:check && npm run daemon:version-check && npm run daemon:build && npm run daemon:stage",
    "package": "electron-forge package",
    "postpackage": "node scripts/verify-packaged-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vite.renderer.config.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/node": "22.15.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.4.1",
    "typescript": "5.6.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
