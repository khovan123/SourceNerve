{
  "openapi": "3.1.0",
  "info": {
    "title": "SourceNerve GPT Actions",
    "version": "0.1.1",
    "description": "ChatGPT Custom GPT Actions surface for SourceNerve. Git remains the source of truth. Mutations preserve SourceNerve exact-HEAD, file-hash, reviewed-diff, branch and provider guards. The stable MCP extension bridge lets ChatGPT discover and dispatch newly installed downstream MCP tools without changing the GPT Actions schema."
  },
  "servers": [
    {
      "url": "__SOURCENERVE_BASE_URL__",
      "description": "The public SourceNerve origin that served this schema"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "List configured SourceNerve workspaces",
        "description": "Returns only configured workspace metadata; clients never supply absolute workspace roots.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/readiness": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check SourceNerve production readiness",
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/mcp/extensions/bridge/catalog": {
      "get": {
        "operationId": "listMcpExtensionCatalog",
        "summary": "List live SourceNerve MCP extension tools",
        "description": "Returns enabled, policy-visible downstream MCP tools with their live input schemas and MCP safety annotations. Use callMcpExtensionReadTool only when annotations.readOnlyHint is true; otherwise use callMcpExtensionWriteTool.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/mcp/extensions/bridge/call/read": {
      "post": {
        "operationId": "callMcpExtensionReadTool",
        "summary": "Dispatch a read-only MCP extension tool",
        "description": "Dispatches only a downstream tool currently classified read-only. SourceNerve rechecks extension enablement, identity, policy, Ask approval, credentials and routing at call time. A write-capable or unknown tool is rejected by this dispatcher.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpExtensionBridgeCallRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/mcp/extensions/bridge/call/write": {
      "post": {
        "operationId": "callMcpExtensionWriteTool",
        "summary": "Dispatch a write-capable or unknown MCP extension tool",
        "description": "Conservative write dispatcher for downstream MCP tools not explicitly classified read-only. SourceNerve still enforces per-tool Automatic/Ask/Blocked policy, credentials, identity and downstream routing. Read-only tools are rejected by this dispatcher.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpExtensionBridgeCallRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/snapshot": {
      "post": {
        "operationId": "getRepositorySnapshot",
        "summary": "Get the current Git HEAD and clean/dirty state",
        "requestBody": {
          "$ref": "#/components/requestBodies/WorkspaceArg"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/read": {
      "post": {
        "operationId": "readFile",
        "summary": "Read a repository-relative UTF-8 source range and full-file SHA-256",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadFileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/patch/preview": {
      "post": {
        "operationId": "previewPatch",
        "summary": "Validate a patch without modifying repository files",
        "description": "Requires exact Git HEAD and one expected full-file SHA per touched path. SourceNerve runs the existing guarded patch preview contract.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/patch/apply": {
      "post": {
        "operationId": "applyPatch",
        "summary": "Apply an already reviewable patch under SourceNerve concurrency guards",
        "description": "Mutates repository files only when exact HEAD, per-file SHA expectations and git apply validation still match.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/git/review": {
      "post": {
        "operationId": "reviewGitChanges",
        "summary": "Return the complete review diff and its SHA-256",
        "requestBody": {
          "$ref": "#/components/requestBodies/WorkspaceArg"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/git/branch/checkout": {
      "post": {
        "operationId": "checkoutFeatureBranch",
        "summary": "Create and checkout a guarded feature branch",
        "description": "Requires a clean tree and exact expected HEAD. The configured default branch cannot be mutated directly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BranchCheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/git/commit": {
      "post": {
        "operationId": "commitReviewedChanges",
        "summary": "Commit only the exact reviewed diff",
        "description": "Requires exact expected HEAD and expected diff SHA-256. Any edit after review fails closed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/git/push": {
      "post": {
        "operationId": "pushFeatureBranch",
        "summary": "Non-force push the current guarded feature branch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/git/default/sync": {
      "post": {
        "operationId": "syncDefaultBranch",
        "summary": "Fast-forward-only sync to the configured default branch and rebuild intelligence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefaultSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/github/issues": {
      "post": {
        "operationId": "createGitHubIssue",
        "summary": "Create an idempotent GitHub issue for a configured GitHub workspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubIssueCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/github/pulls": {
      "post": {
        "operationId": "createGitHubPullRequest",
        "summary": "Create a pull request only when the pushed remote branch equals local HEAD",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubPullCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/github/pulls/get": {
      "post": {
        "operationId": "getGitHubPullRequest",
        "summary": "Read pull request state and current provider head SHA",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubPullGetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    },
    "/api/v1/github/pulls/merge": {
      "post": {
        "operationId": "mergeGitHubPullRequest",
        "summary": "Request a guarded GitHub pull request merge",
        "description": "Requires exact current PR head SHA. SourceNerve never bypasses GitHub branch protection, required checks, reviews or authorization.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubPullMergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use the same server-side SourceNerve bearer token configured by SOURCENERVE_BEARER_TOKEN. Configure it as an API key with Bearer authentication in the GPT Actions editor."
      }
    },
    "responses": {
      "JsonResponse": {
        "description": "SourceNerve JSON response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "requestBodies": {
      "WorkspaceArg": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WorkspaceArg"
            }
          }
        }
      }
    },
    "schemas": {
      "McpExtensionBridgeCallRequest": {
        "type": "object",
        "required": [
          "public_tool"
        ],
        "properties": {
          "public_tool": {
            "type": "string",
            "description": "Namespaced downstream tool name returned by listMcpExtensionCatalog, for example memory__search."
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "Arguments validated by the downstream tool's live input schema returned in the extension catalog."
          }
        },
        "additionalProperties": false
      },
      "WorkspaceArg": {
        "type": "object",
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Configured SourceNerve workspace ID"
          }
        },
        "additionalProperties": false
      },
      "ReadFileRequest": {
        "type": "object",
        "required": [
          "workspace",
          "path"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Repository-relative path only"
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "FileExpectation": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository-relative touched path"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full-file SHA-256 returned by readFile; null only when the path is expected not to exist"
          }
        },
        "additionalProperties": false
      },
      "PatchRequest": {
        "type": "object",
        "required": [
          "workspace",
          "expected_head",
          "expected_files",
          "patch"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "expected_head": {
            "type": "string",
            "description": "Exact Git HEAD captured before generating the patch"
          },
          "expected_files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileExpectation"
            },
            "minItems": 1
          },
          "patch": {
            "type": "string",
            "description": "Unified git patch; bounded by SourceNerve"
          }
        },
        "additionalProperties": false
      },
      "BranchCheckoutRequest": {
        "type": "object",
        "required": [
          "workspace",
          "expected_head",
          "branch"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "expected_head": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "DefaultSyncRequest": {
        "type": "object",
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "CommitRequest": {
        "type": "object",
        "required": [
          "workspace",
          "expected_head",
          "expected_diff_sha256",
          "message"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "expected_head": {
            "type": "string"
          },
          "expected_diff_sha256": {
            "type": "string",
            "description": "SHA-256 returned by reviewGitChanges"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "PushRequest": {
        "type": "object",
        "required": [
          "workspace",
          "expected_head"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "expected_head": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "GitHubIssueCreateRequest": {
        "type": "object",
        "required": [
          "workspace",
          "title"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "default": ""
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "GitHubPullCreateRequest": {
        "type": "object",
        "required": [
          "workspace",
          "expected_head",
          "title"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "expected_head": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "default": ""
          },
          "base": {
            "type": [
              "string",
              "null"
            ]
          },
          "draft": {
            "type": "boolean",
            "default": false
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "GitHubPullGetRequest": {
        "type": "object",
        "required": [
          "workspace",
          "pull_number"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "pull_number": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "GitHubPullMergeRequest": {
        "type": "object",
        "required": [
          "workspace",
          "pull_number",
          "expected_head_sha"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "pull_number": {
            "type": "integer",
            "minimum": 1
          },
          "expected_head_sha": {
            "type": "string"
          },
          "merge_method": {
            "type": "string",
            "enum": [
              "merge",
              "squash",
              "rebase"
            ],
            "default": "squash"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
